# Google Gemini API key (from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# LiveKit Cloud credentials (from LiveKit Cloud dashboard)
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# Telegram user account (Telethon). Fill these in .env.local, not here.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_ALLOWED_CHAT_IDS=

# Email (IMAP/SMTP). Fill these in .env.local, not here.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Alex
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_LIVE=true
EMAIL_ALLOWED_SENDERS=

# GitHub (fine-grained personal access token). Fill these in .env.local, not here.
GH_TOKEN=
GITHUB_OWNER=alexassistant1031-hub
GITHUB_REPO=A-L-E-X
